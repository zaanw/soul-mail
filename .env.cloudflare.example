# Keep actual values in ignored .env.cloudflare or private CI environment.
CLOUDFLARE_ACCOUNT_ID=
# Prefer private runtime/CI injection; never commit a real API token.
CLOUDFLARE_API_TOKEN=
# Existing Hyperdrive ID for your dedicated, migrated production PostgreSQL DB.
CF_HYPERDRIVE_ID=
CF_WORKER_NAME=soul-mail
# Exact HTTPS origin shown in your Cloudflare account, or your owned custom host.
CF_APP_URL=
CF_MAIL_DOMAIN=
MAIL_FROM=
# Optional runtime secrets for external email/inbound mail.
RESEND_API_KEY=
INBOUND_TOKEN=
REQUIRE_EMAIL_VERIFICATION=false
ADMIN_EMAILS=
