DATABASE_URL=postgresql://soul:CHANGE_ME@localhost:5432/soul
APP_URL=http://localhost:3000
MAIL_DOMAIN=localhost
# Optional HTTPS provider (Workers and Node):
RESEND_API_KEY=
MAIL_FROM=
# Optional SMTP transport for Node.js only:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Inbound provider must POST normalized JSON with Authorization: Bearer <this secret>
INBOUND_TOKEN=
# Only enable after configuring outbound delivery for recovery emails.
REQUIRE_EMAIL_VERIFICATION=false
# Comma-separated addresses granted administrator role on registration.
ADMIN_EMAILS=
# Public DNS records shown in settings; obtain exact values from your provider.
MAIL_MX_HOST=
MAIL_SPF=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_VALUE=
MAIL_DMARC=
